# Private local configuration; only nonfunctional example templates are public.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
.publication-private/

# Python environments and generated caches
.venv*/
**/.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Node / Next.js / browser artifacts
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
playwright-report/
test-results/
blob-report/

