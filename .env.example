# Nonfunctional template. Run python scripts/create_local_env.py for private local values.
# Shared runtime configuration
POSTGRES_DB=fluentloop
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@db:5432/fluentloop
REDIS_URL=redis://redis:6379/0

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

APP_ENV=development
DEV_REGISTER_LIMIT=30
ENABLE_DRAFT_LEARNING_PREVIEW=false
APP_NAME=FluentLoop AI
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]

SESSION_COOKIE_NAME=fluentloop_session
SESSION_TTL=1209600
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=fluentloop_csrf
FRONTEND_ORIGIN=http://localhost:3000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=FluentLoop AI <no-reply@fluentloop.local>
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Choose an installed instruct model; no automatic download or fallback.
OLLAMA_MODEL=llama3.2:3b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_INPUT_CHARACTERS=4000
AI_MAX_CONCURRENT_REQUESTS=1
SPEECH_WORKER_URL=http://speech-worker:8090
# Set separate cryptographically random keys before starting optional speech workers.
SPEECH_WORKER_TOKEN=REPLACE_WITH_RANDOM_SPEECH_WORKER_TOKEN
PREVIEW_SPEECH_WORKER_TOKEN=REPLACE_WITH_RANDOM_PREVIEW_WORKER_TOKEN
SPEECH_ASR_PROVIDER=faster_whisper
SPEECH_ASR_MODEL=tiny
# Set to base after explicitly provisioning --asr-model base; Tiny remains compatible.
SPEECH_ASR_DEVICE=cpu
SPEECH_ASR_COMPUTE_TYPE=int8
SPEECH_TTS_PROVIDER=piper
SPEECH_TTS_VOICE=fr_FR-siwis-medium
SPEECH_MODEL_PATH=/models
SPEECH_MAX_UPLOAD_BYTES=5000000
SPEECH_MAX_DURATION_SECONDS=30
SPEECH_PROCESSING_TIMEOUT_SECONDS=60
SPEECH_AUDIO_RETENTION_HOURS=24
PREVIEW_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PREVIEW_DATABASE_PASSWORD
PREVIEW_DATABASE_URL=postgresql+psycopg://REPLACE_WITH_PREVIEW_DATABASE_USER:REPLACE_WITH_RANDOM_PREVIEW_DATABASE_PASSWORD@preview-db:5432/fluentloop_preview
