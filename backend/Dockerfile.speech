FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
COPY requirements.txt requirements-speech.txt ./
RUN pip install --no-cache-dir -r requirements-speech.txt
COPY app ./app
USER 65532:65532
CMD ["uvicorn", "app.speech.worker:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
